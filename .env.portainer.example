# Portainer stack variables
# Copy this file to .env.portainer and fill with your real values.

# Image tag to deploy from registry
PORTFOLIO_TAG=v1

# Backend runtime (required)
DATABASE_URL=postgresql://user:password@host:5432/portfolio_db
ADMIN_PASSWORD=change_this_admin_password
CORS_ORIGIN=https://your-frontend-domain
RECAPTCHA_SECRET_KEY=

# Frontend runtime config (loaded at container startup)
VITE_API_BASE_URL=https://your-api-domain
VITE_RECAPTCHA_SITE_KEY=
