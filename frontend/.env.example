VITE_API_BASE_URL="http://localhost:4000"
# Google reCAPTCHA v2 — get from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"
VITE_ALLOWED_HOSTS="localhost"

# Optional: configure Vite HMR when developing behind a reverse proxy/domain.
# Example: VITE_HMR_HOST="resume.ismail.id"
VITE_HMR_HOST=""
# Use "wss" for HTTPS domain proxy, "ws" for plain HTTP/local.
VITE_HMR_PROTOCOL="ws"
# Client websocket port (443 for HTTPS proxy, 5173 for local dev).
VITE_HMR_CLIENT_PORT="5173"
